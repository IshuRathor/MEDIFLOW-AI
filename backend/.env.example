# Local SQLite database (do not commit backend/.env or backend/hospital.db).
DATABASE_URL=sqlite:///./hospital.db
# For PostgreSQL, use a private connection string such as:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/hospital_management

# Development/production mode.
ENVIRONMENT=development

# Generate a unique local secret, for example:
# Python: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-placeholder-with-a-unique-random-secret

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional timezone for booking language such as "today" and "tomorrow".
HOSPITAL_TIMEZONE=Asia/Kolkata

# Optional Gemini API key for real AI orchestration.
# Leave blank to use deterministic fallback behavior.
GEMINI_API_KEY=

# Optional Redis URL. Leave blank to use process-local rate limiting.
REDIS_URL=

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
