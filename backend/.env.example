# Use PostgreSQL in shared or production environments.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/hospital_management

# Local development uses SQLite when DATABASE_URL is omitted.
DATABASE_URL=sqlite:///./hospital.db

# Required only for AI chat and AI-assisted routing.
GEMINI_API_KEY=

# Development-only fallback. Production requires a random 32+ character secret.
ENVIRONMENT=development
JWT_SECRET_KEY=

# Optional Redis. Leave blank to use process-local fallback rate limiting.
REDIS_URL=

# Comma-separated browser origins for the frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000